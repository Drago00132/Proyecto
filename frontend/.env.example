# URL del backend. En desarrollo local puedes dejar este archivo sin usar
# (axiosConfig.js ya usa http://localhost:3100 por defecto si esta variable
# no está definida). Para desplegar en Netlify, copia este archivo como
# variable de entorno del sitio (Site settings → Environment variables) con
# el valor real de la URL del backend desplegado en Render, por ejemplo:
# REACT_APP_API_URL=https://sigat-backend.onrender.com
REACT_APP_API_URL=http://localhost:3100
